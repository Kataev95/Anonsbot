# Обязательно
BOT_TOKEN=123456:YOUR_TOKEN_HERE

# Группы, в которых разрешено вызывать /start@имя_бота
CHAT_IDS=-1001111111111,-1002222222222
# CHAT_ID=-1001234567890

# Обычный API: в ЛС успешно работал с этим режимом
WIDGET_API_BETA=0

# Увеличьте версию, чтобы отправить новое сообщение
WIDGET_VERSION=3

# Опционально: фиксированная дата (часовой пояс обязателен)
# LAUNCH_AT=2026-11-18T22:00:00+03:00

# Для хранения истории публикаций между перезапусками
STATE_DIR=.

# Ваш числовой Telegram ID: только этот пользователь может использовать /testforward
OWNER_ID=123456789

# Для тестирования Inline Mode включите Inline Mode в @BotFather /setinline.
# В группе используйте: @UsernameБота anons
