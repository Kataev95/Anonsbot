# Настраиваются в панели хостинга (НЕ коммитьте настоящий токен!)
BOT_TOKEN=123456:YOUR_TOKEN_HERE
# Несколько чатов через запятую, без пробелов (или один CHAT_ID)
CHAT_IDS=-1001111111111,-1002222222222
# CHAT_ID=-1001234567890
# 1 — beta Bot API 10.4; 0 — обычный Bot API, если там уже есть sendWidget
WIDGET_API_BETA=1
# Необязательно. Если не указано — 10 суток от первой публикации.
# LAUNCH_AT=2026-11-18T22:00:00+03:00
# Опционально: папка постоянного хранилища, например /data
STATE_DIR=.

# Только личный тест: при указании этой переменной CHAT_IDS не используются.
# PRIVATE_TEST_CHAT_ID=123456789

# Новая версия HTML: создаёт одно новое сообщение для повторного теста
# WIDGET_VERSION=2
